# MongoDB: online rooms (kumkom_db.rooms). Optional: without it rooms are kept in server
# memory, which is fine locally but unreliable on Vercel. The dictionary ships with the app.
MONGODB_URI=
# MONGODB_DB=kumkom_db

# Sign-in (optional). Each provider is enabled only when both of its values are set.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Pusher, for online play.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
